{
  "manifestVersion": 2,
  "id": "cfml",
  "name": "CFML",
  "version": "0.1.1",
  "description": "ColdFusion (CFML) highlighting for tag templates, script components and .cfs files, with embedded CSS, JavaScript and SQL.",
  "license": "MIT",
  "repository": "https://github.com/cfmleditor/orca-cfml",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "syntaxes": [
      {
        "id": "cfml",
        "title": "CFML",
        "scopeName": "embedding.cfml",
        "path": "syntaxes/cfml.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [".cfm", ".cfml", ".cfc"]
      },
      {
        "id": "cfscript",
        "title": "CFScript",
        "scopeName": "embedding.cfml.cfs",
        "path": "syntaxes/cfml-cfs.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [".cfs"]
      }
    ]
  },
  "capabilities": []
}
